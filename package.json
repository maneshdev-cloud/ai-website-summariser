{
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "description": "Paste a URL, get a structured AI summary. Server-side fetching, Mozilla Readability extraction, chunked map-reduce summarisation with Groq, and grounded Q&A over the page.",
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  },
  "name": "ai-website-summariser",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev-server.mjs",
    "dev:web": "vite",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js"
  },
  "type": "module",
  "version": "1.0.0"
}
