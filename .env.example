# Copy this to .env and add your Groq key (free at https://console.groq.com/keys).
# Server-side only — it's never sent to the browser. With no key the app
# still runs, in a basic extractive demo mode.
GROQ_API_KEY=

# Model overrides (defaults shown):
# GROQ_MODEL_SUMMARY=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b

# Port for the local API dev server. Vite proxies /api to this in dev.
# API_PORT=8787
