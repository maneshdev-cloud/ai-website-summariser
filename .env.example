# Copy this file to .env and fill in your key. The key is read ONLY by the
# server-side API handlers (lib/server, api/) — it is never sent to the browser.

# Get a free key at https://console.groq.com/keys
# Optional: if left empty, the app still runs in a keyless "demo-extractive"
# mode (a built-in extractive summariser) so the project works out of the box.
GROQ_API_KEY=

# Optional model overrides (defaults shown):
# GROQ_MODEL_SUMMARY=llama-3.3-70b-versatile
# GROQ_MODEL_FAST=llama-3.1-8b-instant

# Port for the local API dev server (scripts/dev-server.mjs). Vite proxies
# /api to this port in development.
# API_PORT=8787
